<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.feira</groupId>
    <artifactId>feira</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>plataforma</artifactId>
  <name>Feira :: Plataforma</name>
  <description>
    Infraestrutura de mensageria compartilhada: outbox, inbox e politica de
    consumo. Os tres servicos precisam exatamente das mesmas garantias, e
    copiar isso tres vezes significaria corrigir tres vezes cada defeito.
  </description>

  <dependencies>
    <dependency>
      <groupId>br.com.feira</groupId>
      <artifactId>contratos</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Rastro distribuído. A métrica diz que o pedido ficou lento; o rastro diz
      em qual dos quatro serviços. Num sistema orientado a eventos essa é a
      primeira pergunta de qualquer plantão.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!--
      Um trecho por consulta ao banco. Sem isto o rastro diz que o consumo
      levou 800 ms, e não qual consulta dentro dele, que é onde mora o
      problema de uma consulta virar N.
    -->
    <dependency>
      <groupId>net.ttddyy</groupId>
      <artifactId>datasource-proxy</artifactId>
      <version>1.11.0</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

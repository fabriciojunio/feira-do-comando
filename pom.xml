<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.feira</groupId>
  <artifactId>feira</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Feira</name>
  <description>Plataforma de pedidos orientada a eventos</description>

  <modules>
    <module>contratos</module>
    <module>plataforma</module>
    <module>servico-pedidos</module>
    <module>servico-estoque</module>
    <module>servico-pagamentos</module>
    <module>servico-consulta</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>3.5.16</spring-boot.version>
    <postgres.embutido.version>16.2.0</postgres.embutido.version>
    <archunit.version>1.3.0</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <springdoc.version>2.8.6</springdoc.version>
    <resilience4j.version>2.2.0</resilience4j.version>

    <!--
      O Spring Boot 3.5 saiu do suporte gratuito em junho de 2026 e a 3.5.16 é
      a última. As bibliotecas abaixo têm falha publicada com correção na mesma
      linha de versão, então são fixadas aqui por cima do que o Boot traz. Ao
      migrar para o Boot 4, este bloco inteiro sai.
    -->
    <jackson-corrigido.version>2.21.7</jackson-corrigido.version>
    <log4j-corrigido.version>2.25.5</log4j-corrigido.version>
    <opentelemetry-corrigido.version>1.62.0</opentelemetry-corrigido.version>
    <tomcat-corrigido.version>10.1.59</tomcat-corrigido.version>
    <postgresql-corrigido.version>42.7.12</postgresql-corrigido.version>
    <lz4-corrigido.version>1.11.4</lz4-corrigido.version>
    <snappy-corrigido.version>1.1.10.9</snappy-corrigido.version>
    <commons-lang3-corrigido.version>3.21.0</commons-lang3-corrigido.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Correções de segurança: antes do BOM do Boot, porque entre BOMs vale o primeiro. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-corrigido.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j-corrigido.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry-corrigido.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>${snappy-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3-corrigido.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>br.com.feira</groupId>
        <artifactId>contratos</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.feira</groupId>
        <artifactId>plataforma</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>2.2.2</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
        <version>${postgres.embutido.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
        <version>${postgres.embutido.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <!--
                Sem isto o nome dos parametros nao vai para o bytecode, e o
                Spring nao consegue resolver @PathVariable, @RequestParam nem
                @RequestHeader sem nome explicito. O spring-boot-starter-parent
                ja liga essa flag; aqui o parent e o BOM, que so gerencia
                versao, entao a configuracao precisa ser declarada.
              -->
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>relatorio</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

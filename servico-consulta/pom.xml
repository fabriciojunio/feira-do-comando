<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.feira</groupId>
    <artifactId>feira</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>servico-consulta</artifactId>
  <name>Feira :: Servico de Consulta</name>
  <description>
    Modelo de leitura do pedido, montado a partir dos eventos e guardado em
    MongoDB. Existe porque cada servico tem o proprio banco e nenhum deles
    consegue responder sozinho "como esta o meu pedido".
  </description>

  <dependencies>
    <dependency>
      <groupId>br.com.feira</groupId>
      <artifactId>plataforma</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      MongoDB de verdade no teste, iniciado pelo proprio teste, sem Docker.
      Pela mesma razao do PostgreSQL embutido nos outros modulos: teste que so
      roda quando alguem lembra de subir infraestrutura e teste que nao roda.
    -->
    <dependency>
      <groupId>de.flapdoodle.embed</groupId>
      <artifactId>de.flapdoodle.embed.mongo.spring3x</artifactId>
      <version>4.20.0</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!--
          Sem esta execucao o jar sai sem manifesto executavel, porque este
          projeto usa o Boot como BOM e nao como parent, e o goal repackage
          so e ligado sozinho pelo parent. O sintoma e o container subindo e
          morrendo com "no main manifest attribute", e ele nao aparecia no CI
          porque nada levantava o compose ate agora.
        -->
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
